{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi --allow-net=localhost,127.0.0.1,0.0.0.0:5173,[::]:5173 npm:vite",
    "build": "deno task check && deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi npm:vite build",
    "preview": "deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi --allow-net=localhost,127.0.0.1,0.0.0.0:4173,[::]:4173 npm:vite preview",
    "check": "deno check src/ vite.config.ts",
    "test": "deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi --allow-net=localhost,127.0.0.1 npm:vitest run",
    "test:watch": "deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi --allow-net=localhost,127.0.0.1 npm:vitest"
  },
  "imports": {
    "react": "npm:react@19.3.1",
    "react/": "npm:/react@19.3.1/",
    "react-dom": "npm:react-dom@19.3.1",
    "react-dom/": "npm:/react-dom@19.3.1/",
    "react-router": "npm:react-router@8.5.0",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "vite": "npm:vite@8.3.5",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.1.2",
    "vitest": "npm:vitest@5.0.5",
    "vitest/": "npm:/vitest@5.0.5/",
    "jsdom": "npm:jsdom@30.1.3",
    "@testing-library/react": "npm:@testing-library/react@16.3.3",
    "@testing-library/dom": "npm:@testing-library/dom@10.4.2",
    "@testing-library/user-event": "npm:@testing-library/user-event@14.6.8",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@7.0.1",
    "@testing-library/jest-dom/": "npm:/@testing-library/jest-dom@7.0.1/"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "strict": true
  }
}
